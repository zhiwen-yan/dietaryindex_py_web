# DietaryIndex deployment example

# Runtime directory for uploaded files and exported results
DIETARYINDEX_RUNTIME_DIR=./runtime_data

# Optional: enable API key protection for all /v1/* endpoints
# Leave blank for local development. For public deployment, set a long random value.
DIETARYINDEX_API_KEY=
DIETARYINDEX_REQUIRE_API_KEY=false

# Upload and logging controls
DIETARYINDEX_MAX_UPLOAD_MB=100
DIETARYINDEX_LOG_LEVEL=INFO

# Local side-by-side ports
DIETARYINDEX_SITE_PORT=3003
DIETARYINDEX_API_PORT=8001
